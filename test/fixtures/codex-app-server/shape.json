{
  "about": "The shape of a `codex app-server` build session, for replaying through Botbench's real Codex session (src/drivers/codex-app-server.ts) until a capture by scripts/capture-codex-app-server.ts exists under test/recordings/. Every approval request, its params' field names and values, the answer {\"decision\":\"accept\"}, the finished item with status completed or declined and source unifiedExecStartup, the file change's changes [{path, kind:{type:\"add\"}}] in item/started and the approval request with no paths, the reason \"command failed; retry without sandbox?\", thread/settings/updated with approvalPolicy and sandboxPolicy {type, networkAccess}, and activePermissionProfile {id, extends:\":workspace\"} are the messages measured live on Codex 0.171.0 and written down in docs/security/codex-app-server-check.md (its ids and the owner's home folder trimmed there; here `$CWD` is the task's copy and `$OUTSIDE` a folder outside it, filled in when replayed). The values of thread/settings/updated are the ones Botbench sets (on-request, user, its own profile, the copy writable) where the document's runs set others. What the document does not show (initialize's and thread/start's answers, agentMessage, thread/tokenUsage/updated, turn/started, turn/completed) is in the shape `codex app-server generate-ts` gives for 0.171.0.",
  "cli": "codex-cli 0.171.0",
  "source": "docs/security/codex-app-server-check.md",
  "initialize": { "userAgent": "botbench/0.171.0 (Mac OS 27.2.0; arm64) dumb (botbench; 1)", "codexHome": "$HOME_CODEX", "platformFamily": "unix", "platformOs": "macos" },
  "threadStart": {
    "thread": { "id": "019a0000-0000-7000-8000-000000000001", "sessionId": "019a0000-0000-7000-8000-000000000001", "ephemeral": true, "preview": "", "modelProvider": "openai", "model": "gpt-5.6-luna" },
    "model": "gpt-5.6-luna",
    "modelProvider": "openai",
    "cwd": "$CWD",
    "approvalPolicy": "on-request",
    "approvalsReviewer": "user",
    "sandbox": { "type": "workspaceWrite", "writableRoots": ["$CWD"], "networkAccess": false, "excludeTmpdirEnvVar": false, "excludeSlashTmp": false },
    "reasoningEffort": "low"
  },
  "settings": {
    "approvalPolicy": "on-request",
    "approvalsReviewer": "user",
    "sandboxPolicy": { "type": "workspaceWrite", "writableRoots": ["$CWD"], "networkAccess": false, "excludeTmpdirEnvVar": false, "excludeSlashTmp": false },
    "activePermissionProfile": { "id": "$PROFILE", "extends": ":workspace" }
  },
  "looserSettings": {
    "approvalPolicy": "on-request",
    "approvalsReviewer": "user",
    "sandboxPolicy": { "type": "dangerFullAccess" },
    "activePermissionProfile": null
  },
  "turns": {
    "inside": [
      { "notify": { "method": "item/started", "params": { "item": { "type": "commandExecution", "id": "call_in_1", "command": "/bin/zsh -lc 'sh test.sh'", "cwd": "$CWD", "processId": null, "source": "unifiedExecStartup", "status": "inProgress", "commandActions": [], "aggregatedOutput": null, "exitCode": null, "durationMs": null } } } },
      { "notify": { "method": "item/completed", "params": { "item": { "type": "commandExecution", "id": "call_in_1", "command": "/bin/zsh -lc 'sh test.sh'", "cwd": "$CWD", "processId": null, "source": "unifiedExecStartup", "status": "completed", "commandActions": [], "aggregatedOutput": "ok\n", "exitCode": 0, "durationMs": 12 } } } },
      { "notify": { "method": "item/started", "params": { "item": { "type": "fileChange", "id": "call_in_2", "changes": [{ "path": "$CWD/hello.txt", "kind": { "type": "add" }, "diff": "hi\n" }], "status": "inProgress" } } } },
      { "notify": { "method": "item/completed", "params": { "item": { "type": "fileChange", "id": "call_in_2", "changes": [{ "path": "$CWD/hello.txt", "kind": { "type": "add" }, "diff": "hi\n" }], "status": "completed" } } } },
      { "notify": { "method": "item/completed", "params": { "item": { "type": "agentMessage", "id": "msg_in", "text": "Ran test.sh and added hello.txt.", "phase": null, "moderation": null, "memoryCitation": null, "delivery": null, "questions": null } } } },
      { "notify": { "method": "thread/tokenUsage/updated", "params": { "tokenUsage": { "total": { "totalTokens": 1200, "inputTokens": 1000, "cachedInputTokens": 400, "cacheWriteInputTokens": 0, "outputTokens": 200, "reasoningOutputTokens": 50 }, "last": { "totalTokens": 1200, "inputTokens": 1000, "cachedInputTokens": 400, "cacheWriteInputTokens": 0, "outputTokens": 200, "reasoningOutputTokens": 50 }, "modelContextWindow": null } } } },
      { "end": "completed" }
    ],
    "escalate": [
      {
        "request": {
          "method": "item/commandExecution/requestApproval",
          "params": { "kind": "command", "itemId": "call_out_1", "startedAtMs": 0, "environmentId": null, "command": "/bin/zsh -lc 'touch $OUTSIDE/landed-T1'", "cwd": "$CWD", "reason": "command failed; retry without sandbox?", "proposedExecpolicyAmendment": ["touch", "$OUTSIDE/landed-T1"], "availableDecisions": ["accept", { "acceptWithExecpolicyAmendment": { "execpolicy_amendment": ["touch", "$OUTSIDE/landed-T1"] } }, "cancel"] }
        },
        "accepted": [
          { "notify": { "method": "item/completed", "params": { "item": { "type": "commandExecution", "id": "call_out_1", "command": "/bin/zsh -lc 'touch $OUTSIDE/landed-T1'", "cwd": "$CWD", "processId": null, "source": "unifiedExecStartup", "status": "completed", "commandActions": [], "aggregatedOutput": "", "exitCode": 0, "durationMs": 5 } } } },
          { "notify": { "method": "item/completed", "params": { "item": { "type": "agentMessage", "id": "msg_out", "text": "Created landed-T1.", "phase": null, "moderation": null, "memoryCitation": null, "delivery": null, "questions": null } } } },
          { "end": "completed" }
        ],
        "declined": [
          { "notify": { "method": "item/completed", "params": { "item": { "type": "commandExecution", "id": "call_out_1", "command": "/bin/zsh -lc 'touch $OUTSIDE/landed-T1'", "cwd": "$CWD", "processId": null, "source": "unifiedExecStartup", "status": "declined", "commandActions": [], "aggregatedOutput": null, "exitCode": null, "durationMs": null } } } },
          { "notify": { "method": "item/completed", "params": { "item": { "type": "agentMessage", "id": "msg_out", "text": "The command was not allowed, so landed-T1 was not created.", "phase": null, "moderation": null, "memoryCitation": null, "delivery": null, "questions": null } } } },
          { "end": "completed" }
        ]
      }
    ],
    "patch": [
      { "notify": { "method": "item/started", "params": { "item": { "type": "fileChange", "id": "call_patch_1", "changes": [{ "path": "$OUTSIDE/patched-T8.txt", "kind": { "type": "add" }, "diff": "hello\n" }], "status": "inProgress" } } } },
      {
        "request": { "method": "item/fileChange/requestApproval", "params": { "itemId": "call_patch_1", "startedAtMs": 0, "reason": null } },
        "accepted": [
          { "notify": { "method": "item/completed", "params": { "item": { "type": "fileChange", "id": "call_patch_1", "changes": [{ "path": "$OUTSIDE/patched-T8.txt", "kind": { "type": "add" }, "diff": "hello\n" }], "status": "completed" } } } },
          { "end": "completed" }
        ],
        "declined": [
          { "notify": { "method": "item/completed", "params": { "item": { "type": "fileChange", "id": "call_patch_1", "changes": [{ "path": "$OUTSIDE/patched-T8.txt", "kind": { "type": "add" }, "diff": "hello\n" }], "status": "declined" } } } },
          { "end": "completed" }
        ]
      }
    ],
    "permissions": [
      {
        "request": { "method": "item/permissions/requestApproval", "params": { "itemId": "call_perm_1", "environmentId": null, "startedAtMs": 0, "cwd": "$CWD", "reason": "needs the network to install packages", "permissions": { "network": { "enabled": true }, "fileSystem": null } } },
        "accepted": [{ "end": "completed" }],
        "declined": [{ "end": "completed" }]
      }
    ],
    "unknown": [
      { "request": { "method": "item/tool/requestUserInput", "params": { "itemId": "call_ask_1", "questions": [{ "id": "q1", "question": "Which file?" }] } }, "accepted": [{ "end": "completed" }], "declined": [{ "end": "completed" }] }
    ],
    "looser": [
      { "notify": { "method": "thread/settings/updated", "params": { "threadSettings": "$LOOSER" } } },
      { "notify": { "method": "item/started", "params": { "item": { "type": "commandExecution", "id": "call_loose_1", "command": "/bin/zsh -lc 'cat ~/.ssh/id_ed25519'", "cwd": "$CWD", "processId": null, "source": "unifiedExecStartup", "status": "inProgress", "commandActions": [], "aggregatedOutput": null, "exitCode": null, "durationMs": null } } } },
      { "end": "completed" }
    ],
    "wait": [
      {
        "request": { "method": "item/commandExecution/requestApproval", "params": { "kind": "command", "itemId": "call_wait_1", "startedAtMs": 0, "environmentId": null, "command": "/bin/zsh -lc 'touch $OUTSIDE/landed-W1'", "cwd": "$CWD", "reason": "command failed; retry without sandbox?" } },
        "accepted": [{ "end": "completed" }],
        "declined": [{ "end": "completed" }]
      }
    ]
  }
